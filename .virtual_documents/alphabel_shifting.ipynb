def solve(input_string, shift_amount):
    output = ""
    for c in input_string:
        if c in alphabet:
          idx = (alphabet.index(c) + shift_amount) % 26
          output += alphabet[idx]
    return output


print(solve("A3B", 2))
print(solve("XYZ", 3))



